# ============================================================
# Unity 自动生成的缓存
# 这些东西都能从 Assets / ProjectSettings / Packages 重新生成，
# 不该进仓库（Library 单独就有 2.2 GB，Assets 才 4.5 MB）
# ============================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity 的崩溃日志和系统信息
sysinfo.txt

# ============================================================
# IDE 生成的文件（Visual Studio / Rider / VS Code）
# ============================================================
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.opendb

# ============================================================
# 构建产物
# ============================================================
*.apk
*.aab
*.unitypackage
*.app
builds/

# ============================================================
# 操作系统产生的文件
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# WorkBuddy 的笔记和路线图（你自己决定要不要进仓库）
# 想提交就把下面这行的 # 去掉
# ============================================================
# .workbuddy/
